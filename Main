```java
package com.techlab.app;

import com.techlab.productos.Producto;
import com.techlab.pedidos.LineaPedido;
import com.techlab.pedidos.Pedido;
import com.techlab.excepciones.StockInsuficienteException;

import java.util.*;
import java.util.stream.Collectors;

public class Main {

    private static final Scanner scanner = new Scanner(System.in);
    private static final List<Producto> productos = new ArrayList<>();
    private static final List<Pedido> pedidos = new ArrayList<>();

    public static void main(String[] args) {
        cargarEjemplo(); // quita o reemplaza con persistencia si querés
        int opcion;
        do {
            mostrarMenuPrincipal();
            opcion = leerEntero("Seleccione una opción: ");
            switch (opcion) {
                case 1 -> gestionarProductos();
                case 2 -> gestionarCategoriasPlaceholder();
                case 3 -> verCarritoPlaceholder();
                case 4 -> crearPedido();
                case 5 -> listarPedidos();
                case 6 -> administracion();
                case 7 -> System.out.println("Gracias. Proyecto TechLab - Adriana Serrano.");
                default -> System.out.println("Opción inválida.");
            }
        } while (opcion != 7);
    }

    private static void mostrarMenuPrincipal() {
        System.out.println("""
                
                =================================== SISTEMA DE GESTIÓN - TECHLAB ==================================
                                   Proyecto Final - Adriana Serrano
                =====================================================================================================
                1) Gestionar Productos
                2) Gestionar Categorías (placeholder)
                3) Ver Carrito (placeholder)
                4) Realizar Pedido
                5) Consultar Historial de Pedidos
                6) Administración (usuarios / stock)
                7) Salir
                =====================================================================================================
                """);
    }

    // --------------------- GESTIÓN PRODUCTOS ---------------------

    private static void gestionarProductos() {
        int opt;
        do {
            System.out.println("""
                    
                    ----- GESTIÓN DE PRODUCTOS -----
                    a) Agregar producto
                    b) Listar productos
                    c) Buscar producto (por ID o nombre)
                    d) Actualizar producto
                    e) Eliminar producto
                    f) Reporte: stock bajo
                    0) Volver al menú principal
                    --------------------------------
                    """);
            String entrada = leerLinea("Elija una opción: ").trim().toLowerCase();
            if (entrada.isEmpty()) continue;
            char opcion = entrada.charAt(0);
            switch (opcion) {
                case 'a' -> agregarProducto();
                case 'b' -> listarProductos();
                case 'c' -> buscarProductoInterfaz();
                case 'd' -> actualizarProductoInterfaz();
                case 'e' -> eliminarProductoInterfaz();
                case 'f' -> reporteStockBajoInterfaz();
                case '0' -> { return; }
                default -> System.out.println("Opción inválida.");
            }
        } while (true);
    }

    private static void agregarProducto() {
        String nombre = leerLinea("Nombre: ");
        if (nombre.isBlank()) {
            System.out.println("Nombre inválido. Operación cancelada.");
            return;
        }
        double precio = leerDouble("Precio: ");
        if (precio <= 0) {
            System.out.println("Precio inválido. Operación cancelada.");
            return;
        }
        int stock = leerEntero("Stock: ");
        if (stock < 0) {
            System.out.println("Stock inválido. Operación cancelada.");
            return;
        }
        Producto prod = new Producto(nombre, precio, stock);
        productos.add(prod);
        System.out.println("Producto agregado: " + prod);
    }

    private static void listarProductos() {
        if (productos.isEmpty()) {
            System.out.println("No hay productos cargados.");
            return;
        }
        System.out.println("=== LISTADO DE PRODUCTOS ===");
        productos.forEach(System.out::println);
    }

    private static void buscarProductoInterfaz() {
        String criterio = leerLinea("Buscar por ID (número) o por nombre (texto): ");
        if (criterio.isBlank()) {
            System.out.println("Búsqueda vacía.");
            return;
        }
        try {
            int id = Integer.parseInt(criterio.trim());
            Producto p = productos.stream().filter(prod -> prod.getId() == id).findFirst().orElse(null);
            if (p == null) System.out.println("Producto con ID " + id + " no encontrado.");
            else System.out.println(p);
        } catch (NumberFormatException e) {
            List<Producto> encontrados = productos.stream()
                    .filter(prod -> prod.getNombre().toLowerCase().contains(criterio.toLowerCase()))
                    .collect(Collectors.toList());
            if (encontrados.isEmpty()) System.out.println("No se encontraron productos con ese nombre.");
            else encontrados.forEach(System.out::println);
        }
    }

    private static void actualizarProductoInterfaz() {
        int id = leerEntero("Ingrese ID del producto a actualizar: ");
        Producto p = productos.stream().filter(prod -> prod.getId() == id).findFirst().orElse(null);
        if (p == null) {
            System.out.println("Producto no encontrado.");
            return;
        }
        System.out.println("Producto: " + p);
        System.out.println("Qué desea actualizar? (n)ombre / (p)recio / (s)tock / (c)ancelar");
        String opcion = leerLinea("Opción: ").trim().toLowerCase();
        switch (opcion) {
            case "n" -> {
                String nuevoNombre = leerLinea("Nuevo nombre: ");
                try { p.setNombre(nuevoNombre); System.out.println("Nombre actualizado."); }
                catch (IllegalArgumentException ex) { System.out.println("Error: " + ex.getMessage()); }
            }
            case "p" -> {
                double nuevoPrecio = leerDouble("Nuevo precio: ");
                try { p.setPrecio(nuevoPrecio); System.out.println("Precio actualizado."); }
                catch (IllegalArgumentException ex) { System.out.println("Error: " + ex.getMessage()); }
            }
            case "s" -> {
                int nuevoStock = leerEntero("Nuevo stock: ");
                try { p.setStock(nuevoStock); System.out.println("Stock actualizado."); }
                catch (IllegalArgumentException ex) { System.out.println("Error: " + ex.getMessage()); }
            }
            default -> System.out.println("Cancelado o opción inválida.");
        }
    }

    private static void eliminarProductoInterfaz() {
        int id = leerEntero("Ingrese ID del producto a eliminar: ");
        Producto p = productos.stream().filter(prod -> prod.getId() == id).findFirst().orElse(null);
        if (p == null) {
            System.out.println("Producto no encontrado.");
            return;
        }
        System.out.println("Producto encontrado: " + p);
        String confirmar = leerLinea("Confirma eliminación? (s/n): ").trim().toLowerCase();
        if (confirmar.equals("s")) {
            productos.removeIf(prod -> prod.getId() == id);
            System.out.println("Producto eliminado.");
        } else {
            System.out.println("Eliminación cancelada.");
        }
    }

    private static void reporteStockBajoInterfaz() {
        int limite = leerEntero("Ingrese límite de stock para alerta: ");
        List<Producto> bajos = productos.stream()
                .filter(prod -> prod.getStock() <= limite)
                .sorted(Comparator.comparingInt(Producto::getStock))
                .collect(Collectors.toList());
        if (bajos.isEmpty()) {
            System.out.println("No hay productos con stock menor o igual a " + limite);
            return;
        }
        System.out.println("=== Productos con stock bajo ===");
        bajos.forEach(System.out::println);
    }

    // --------------------- PEDIDOS ---------------------

    private static void crearPedido() {
        if (productos.isEmpty()) {
            System.out.println("No hay productos disponibles para crear un pedido.");
            return;
        }
        Pedido pedido = new Pedido();
        Map<Producto, Integer> seleccion = new LinkedHashMap<>();

        while (true) {
            listarProductos();
            int id = leerEntero("Ingrese ID de producto a agregar (0 para finalizar selección): ");
            if (id == 0) break;

            Producto p = productos.stream().filter(prod -> prod.getId() == id).findFirst().orElse(null);
            if (p == null) {
                System.out.println("Producto no encontrado.");
                continue;
            }

            int cantidad = leerEntero("Cantidad: ");
            if (cantidad <= 0) {
                System.out.println("Cantidad inválida.");
                continue;
            }

            int acumulado = seleccion.getOrDefault(p, 0) + cantidad;
            if (acumulado > p.getStock()) {
                System.out.println("Stock insuficiente para ese pedido (disponible: " + p.getStock() + ").");
                continue;
            }
            seleccion.put(p, acumulado);
            System.out.println("Se agregó " + cantidad + " x " + p.getNombre());
        }

        if (seleccion.isEmpty()) {
            System.out.println("No se seleccionaron productos. Pedido cancelado.");
            return;
        }

        System.out.println("Resumen del pedido:");
        seleccion.forEach((prod, cant) -> System.out.println(prod.getNombre() + " x" + cant + " = $" + String.format("%.2f", prod.getPrecio() * cant)));

        String confirmar = leerLinea("Confirmar pedido y descontar stock? (s/n): ").trim().toLowerCase();
        if (!confirmar.equals("s")) {
            System.out.println("Pedido cancelado.");
            return;
        }

        // Descontar stock y agregar líneas
        try {
            for (Map.Entry<Producto, Integer> entry : seleccion.entrySet()) {
                Producto prod = entry.getKey();
                int cant = entry.getValue();
                if (cant > prod.getStock()) throw new StockInsuficienteException("Stock insuficiente para " + prod.getNombre());
                prod.disminuirStock(cant); // usa método seguro del modelo
                pedido.agregarLinea(new LineaPedido(prod, cant));
            }
        } catch (StockInsuficienteException | IllegalArgumentException ex) {
            System.out.println("Error al crear pedido: " + ex.getMessage());
            return;
        }

        pedidos.add(pedido);
        System.out.println("Pedido creado exitosamente:");
        System.out.println(pedido);
    }

    private static void listarPedidos() {
        if (pedidos.isEmpty()) {
            System.out.println("No hay pedidos registrados.");
            return;
        }
        System.out.println("=== HISTORIAL DE PEDIDOS ===");
        pedidos.forEach(System.out::println);
    }

    // --------------------- ADMINISTRACION (placeholder) ---------------------

    private static void administracion() {
        System.out.println("Administración: función placeholder (se puede extender para gestionar usuarios y permisos).");
    }

    private static void gestionarCategoriasPlaceholder() {
        System.out.println("Gestión de categorías: función placeholder (requerimientos del front-end / template).");
    }

    private static void verCarritoPlaceholder() {
        System.out.println("Ver carrito: placeholder para integración con frontend.");
    }

    // --------------------- UTILIDADES ---------------------

    private static int leerEntero(String mensaje) {
        while (true) {
            try {
                System.out.print(mensaje);
                String linea = scanner.nextLine().trim();
                return Integer.parseInt(linea);
            } catch (NumberFormatException e) {
                System.out.println("Debe ingresar un número entero válido.");
            }
        }
    }

    private static double leerDouble(String mensaje) {
        while (true) {
            try {
                System.out.print(mensaje);
                String linea = scanner.nextLine().trim();
                return Double.parseDouble(linea);
            } catch (NumberFormatException e) {
                System.out.println("Debe ingresar un número decimal válido.");
            }
        }
    }

    private static String leerLinea(String mensaje) {
        System.out.print(mensaje);
        return scanner.nextLine();
    }

    // --------------------- DATOS DE EJEMPLO ---------------------

    private static void cargarEjemplo() {
        // datos de ejemplo para facilitar pruebas rápidas
        try {
            productos.add(new Producto("Auriculares", 2500.00, 15));
            productos.add(new Producto("Mouse", 1800.50, 10));
            productos.add(new Producto("Teclado", 3200.75, 5));
        } catch (IllegalArgumentException ignored) {}
    }
}
```
